{
  "name": "@opencode/sami-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --cwd ../../packages/app build && bun prepare-assets.mjs",
    "deploy": "bun run check:hub && bun run check:origin && wrangler deploy --var BUILD_SHA:$(git rev-parse HEAD) && bun run check:origin",
    "check:origin": "bun check-origin-routes.mjs",
    "sync:hub": "bun sync-hub-shell.mjs",
    "check:hub": "bun sync-hub-shell.mjs --check",
    "test": "bun test ./test",
    "typecheck": "bun check --no-script -p tsconfig.json",
    "types": "wrangler types --include-runtime=false"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@typescript/native": "catalog:",
    "wrangler": "4.110.0"
  }
}
